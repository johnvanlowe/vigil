{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerdictExportRowV1",
  "description": "Anonymized verdict export row for machine learning and training flywheel",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "verdict_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": ["confirm", "dismiss", "escalate", "edit_severity", "approve", "reject"]
    },
    "reason_category": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "severity": {
      "type": ["string", "null"]
    },
    "attack_tactics": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attack_techniques": {
      "type": "array",
      "items": { "type": "string" }
    },
    "anonymized_features": {
      "type": "object"
    },
    "exported_at": {
      "type": "string"
    }
  },
  "required": ["schema_version", "action", "exported_at"]
}
