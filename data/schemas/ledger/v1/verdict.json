{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerdictEventV1",
  "description": "Ledger event for UI or automated disposition verdicts",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "finding_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "loglm_provenance": {
      "type": [
        "object",
        "null"
      ]
    },
    "attack_mapping": {
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "action",
    "actor"
  ]
}