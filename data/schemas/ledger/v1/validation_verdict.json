{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ValidationVerdictEventV1",
  "description": "Ledger event for detection validation records",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidate_id": {
      "type": "string"
    },
    "environment_id": {
      "type": "string"
    },
    "is_valid": {
      "type": "boolean"
    },
    "passed_lint": {
      "type": "boolean"
    },
    "passed_replay": {
      "type": "boolean"
    },
    "passed_judge": {
      "type": "boolean"
    },
    "repair_attempts": {
      "type": "integer"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "candidate_id",
    "is_valid"
  ]
}