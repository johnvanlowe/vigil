{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillFrontmatterV1",
  "description": "Frontmatter schema for SKILL.md bundles",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "description"
  ]
}
